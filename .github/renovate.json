{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    "security:openssf-scorecard",
    "github>milkyware/actions"
  ],
  "labels": [
    "dependencies",
    "{{manager}}",
    "{{updateType}}"
  ],
  "automergeStrategy": "squash",
  "minimumReleaseAge": "14 days",
  "semanticCommits": "enabled",
  "separateMajorMinor": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": []
}
