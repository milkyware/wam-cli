<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <PackageId>milkyware-wam-cli</PackageId>
    <ToolCommandName>milkyware-wam-cli</ToolCommandName>
    <Title>MilkyWare WAM CLI</Title>
    <Authors>MilkyWare</Authors>
    <Description>Command line wrapper for generating access tokens using MSAL.NET WAM</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/milkyware/wam-cli</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- x-release-please-start-version -->
    <PackageVersion>0.0.5</PackageVersion>
    <!-- x-release-please-end -->
    <RepositoryUrl>https://github.com/milkyware/wam-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.88.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.88.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
